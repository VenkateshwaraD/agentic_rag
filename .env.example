# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embeddings (bedrock | local) ---
EMBEDDING_PROVIDER=bedrock
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
AWS_REGION=us-east-1
AWS_PROFILE=
# or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# --- Datastores ---
DATABASE_URL=postgresql://rag:rag@localhost:5432/ragdb
OPS_DATABASE_URL=postgresql://rag_readonly:readonly@localhost:5432/opsdb
OPENSEARCH_URL=http://localhost:9200

# --- Auth (prototype) ---
API_KEYS=dev-key-agent1,dev-key-agent2,dev-key-senior,dev-key-admin
USERS_FILE=db/seed/users.json

# --- Langfuse (optional; tracing disabled if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_TOKEN=admin-dev-token

# --- UI ---
API_URL=http://localhost:8000
